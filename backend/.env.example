# =============================================================
# CekInvest Backend — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================

# --- Application ---
APP_NAME="CekInvest API"
APP_VERSION="1.0.0"
DEBUG=false

# --- Prisma Postgres ---
# Option A: Prisma managed Postgres (Prisma Data Platform)
#   DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY"
#
# Option B: Standard PostgreSQL
#   DATABASE_URL="postgresql://user:password@host:5432/cek_invest?schema=public"
DATABASE_URL=postgresql://postgres:password@localhost:5432/cek_invest

# --- SENTRA AI Engine (Gemini) ---
GEMINI_API_KEY=your-primary-gemini-api-key-here
GEMINI_API_KEY_BACKUP_1=your-backup-gemini-api-key-1
GEMINI_API_KEY_BACKUP_2=your-backup-gemini-api-key-2
SENTRA_MODEL=gemini-3.8-flash
SENTRA_MODEL_BACKUP_1=gemini-3.7-flash
SENTRA_MODEL_BACKUP_2=gemini-3.6-flash
SENTRA_MODEL_BACKUP_3=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
