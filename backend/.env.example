# =============================================================
# InvestasiAman Backend — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================

# --- Application ---
APP_NAME="InvestasiAman API"
APP_VERSION="1.0.0"
DEBUG=false

# --- Prisma Postgres ---
# Option A: Prisma managed Postgres (Prisma Data Platform)
#   DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY"
#
# Option B: Standard PostgreSQL
#   DATABASE_URL="postgresql://user:password@host:5432/investasi_aman?schema=public"
DATABASE_URL=postgresql://postgres:password@localhost:5432/investasi_aman

# --- SENTRA AI Engine (Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
SENTRA_MODEL=gemini-2.0-flash

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
